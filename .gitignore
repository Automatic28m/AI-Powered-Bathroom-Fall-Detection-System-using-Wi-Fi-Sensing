# Repo-wide ignore rules (GIT_FLOW.md §5). Each folder adds its own .gitignore.
# Personal or editor-specific files go in .git/info/exclude, not here.

# Secrets
.env
.env.*
!.env.example

# Data, models and generated files (they live on the server under /data)
data/
recordings/
*.safetensors
*.ckpt
*.pt

# Python
__pycache__/
.venv/

# OS
.DS_Store
Thumbs.db
desktop.ini
