# =============================================================
# Next.js / web
# =============================================================
DATABASE_URL="postgresql://user:password@localhost:5432/fallwatch"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# First admin, created by `npx prisma db seed` only when no admin exists yet
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_FULL_NAME="ผู้ดูแลระบบ"
SEED_ADMIN_PHONE="0800000000"

# Internal paths (Docker volume)
DATA_DIR="/data"

# Optional: SMTP (for local testing only — real values never committed)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@gmail.com"
# SMTP_PASS="your-app-password"
